# 必要な環境変数のひな形。.env.local にコピーして値を入れる
# このファイルに実際の値を書かない

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI（サーバー側だけで使う。NEXT_PUBLIC_ を付けない）
ANTHROPIC_API_KEY=
# fake にすると、AIを呼ばずに決まった提案を返す偽物を使う（APIキーなしの動作確認用）。本番では設定しない
AI_SUGGESTER=
# 質問への回答で使うモデル（省略すると claude-haiku-4-5 と claude-sonnet-5-5）
QA_PLANNER_MODEL=
QA_ANSWERER_MODEL=

# DBのテスト（開発用プロジェクトのみ。Vercel には設定しない）
# 1 のときだけ npm run test:db が動く
ALLOW_DB_TESTS=
TEST_VIEWER_EMAIL=
TEST_VIEWER_PASSWORD=
TEST_STEWARD_EMAIL=
TEST_STEWARD_PASSWORD=
# 自分の登録は承認できないため、承認のテストには2人目のスチュワードが要る
TEST_STEWARD2_EMAIL=
TEST_STEWARD2_PASSWORD=
